{
  "manifest_version": 3,
  "name": "Wayfinder — Te guía en tu trámite",
  "version": "0.3.5",
  "description": "Encontrá gestiones y accesos en la página abierta, con catálogos públicos organizados por Bob y guía paso a paso.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://andromedaweb.store/*",
    "https://www.rosario.gob.ar/*",
    "https://siat.rosario.gob.ar/*",
    "https://auth.afip.gob.ar/*",
    "https://vggmunicipalidad.gov.ar/*",
    "https://www.vggmunicipalidad.gov.ar/*"
  ],
  "background": {
    "service_worker": "fondo.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rosario.gob.ar/*",
        "https://vggmunicipalidad.gov.ar/*",
        "https://www.vggmunicipalidad.gov.ar/*"
      ],
      "js": [
        "resaltar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir la guía de Wayfinder",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
