# API local; no exponer sin autenticación y límites por usuario.
PORT=3101
# Ruta al archivo bobshell/dist/bob.js instalado con el paquete oficial.
BOB_ENTRY=
BOB_API_KEY=
BOB_MAX_COST=0.50
# Catálogo: páginas por tarea de Bob y tareas simultáneas
BOB_LOTE=8
BOB_PARALELO=2
# Solo habilitar en pruebas controladas; permite localhost, no la red privada.
WAYFINDER_ALLOW_LOCAL=0
