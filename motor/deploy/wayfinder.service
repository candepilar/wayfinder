[Unit]
Description=Wayfinder web mapping API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wayfinder
Group=wayfinder
WorkingDirectory=/opt/wayfinder/current/motor
Environment=NODE_ENV=production
EnvironmentFile=/etc/wayfinder.env
ExecStart=/usr/bin/node --max-old-space-size=192 src/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=320M
CPUQuota=40%
Nice=10
TasksMax=64
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wayfinder
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
